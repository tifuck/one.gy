# ONE.GY environment variables. Copy to .env and fill in; see README.md for config layers.
# Loaded by load_dotenv() from the folder that holds app.py (src/app/010_imports_config.py:42).
# Secrets are left empty on purpose: the app/backup refuse to run until they are set.
# Every variable the code reads is listed; commented example values are the code's defaults.

# ── Secrets ─────────────────────────────────────────────────────────────────
# Flask session signing key. Required. Generate: python3 -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=
# Fernet key for storage-node configs and non-E2EE payloads. Required.
# Generate: python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
FERNET_KEY=
# Main app DB (MariaDB/MySQL). Required; only ALLOW_SQLITE_APP_DB=true can substitute SQLite.
DATABASE_URL=mysql+pymysql://user:pass@localhost:3306/onegy?charset=utf8mb4
# Shared secret for the X-RateLimit-Bypass test header. Empty = header inert.
RATELIMIT_BYPASS_KEY=
# Passphrase encrypting backup_prod.py archives. Required to create any backup.
# Only read by the backup tooling; not needed to run the app.
BACKUP_ENCRYPTION_KEY=
# Acknowledgement that the escrow keys are stored off-machine (silences the CRITICAL warning).
#BACKUP_KEY_ESCROW_CONFIRMED=1

# ── Server / network ────────────────────────────────────────────────────────
DOMAIN=example.com
#BIND_HOST=0.0.0.0
#WEB_PORT=5000
#TRUSTED_PROXY_HOPS=0        # ProxyFix X-Forwarded-* trust count
#FORCE_HTTPS=1               # any value except 0/false/no/off keeps the HTTPS redirect on
#GUNICORN_WORKERS=1
#GUNICORN_THREADS=8
#RATELIMIT_STORAGE_URI=memory://
#TRUST_CDN_HEADERS=false     # trust CDN client-IP headers (CF-Connecting-IP, ...)

# ── Feature flags (env defaults; the DB AppSettings in the admin UI override these) ──
ALLOW_TEMP_UPLOADS=true
ALLOW_REGISTRATION=true
CAPTCHA_ENABLED=true
ALLOW_API_KEYS=false
WELCOME_FOLDER_ENABLED=false
ALLOW_MUSIC=true

# ── Limits / tunables (example values are the code defaults) ────────────────
#MAX_SIZE_GB=10.0                          # max single upload size (MAX_CONTENT_LENGTH)
#DEFAULT_USER_STORAGE_GB=50.0
#PILLOW_MAX_IMAGE_PIXELS=40000000
#THUMBNAIL_CACHE_MAX_AGE=900
#PREP_STALL_SECONDS=600
#PREP_READY_TTL_SECONDS=300
#PREP_MAX_AGE_SECONDS=1800
#PREP_DOWNLOAD_FREE_SPACE_RESERVE=5368709120   # 5 GiB
#ZIP_DOWNLOAD_MAX_FILES=5000
#ZIP_DOWNLOAD_MAX_BYTES=21474836480            # 20 GiB
#ZIP_DOWNLOAD_MAX_CONCURRENT=4
#ZIP_DOWNLOAD_FREE_SPACE_RESERVE=5368709120    # 5 GiB
#UPLOAD_IDEMPOTENCY_WAIT_SECONDS=300
#UPLOAD_QUOTA_FLOCK_WAIT_SECONDS=300
#GUEST_TEMP_INFLIGHT_TTL=7200                  # seconds

# ── Storage ─────────────────────────────────────────────────────────────────
#MUSIC_LIBRARY_PATH=/srv/music            # music library + SQLite index (default: <home>/music; no ~ expansion)
#STORAGE_NODE_ALLOW_PRIVATE_HOSTS=true     # allow S3/SSH nodes on private/loopback hosts
#STORAGE_SSH_STRICT_HOST_KEY=false         # refuse SSH nodes without a pinned host key
#STORAGE_S3_ALLOW_HTTP=false               # allow plaintext-HTTP S3 endpoints
#STORAGE_REMOVED_NODE_MANIFEST=            # default: instance/removed_node_pending_deletes.jsonl

# ── DEV/test-only switches — NEVER enable in PROD ──────────────────────────
#TESTING=true
#FLASK_ENV=testing                         # 'testing' or 'development'
#FLASK_DEBUG=true
#ALLOW_RATELIMIT_BYPASS=1                  # arms the X-RateLimit-Bypass header
#ALLOW_LOGIN_LOCKOUT_BYPASS=1
#ALLOW_DESTRUCTIVE_PURGE=1                 # unlocks the purge-everything CLI command
#ALLOW_SQLITE_APP_DB=true                  # lets the main app DB fall back to SQLite

# ── Test-suite only (testsv2) ───────────────────────────────────────────────
#ONEGY_TEST_URL=https://dev.example.com
#ONEGY_ADMIN_USER=
#ONEGY_ADMIN_PASS=
#ONEGY_ALLOW_PROD_TESTS=I_UNDERSTAND       # required only when targeting production
#PLAYWRIGHT_HEADLESS=true
#PLAYWRIGHT_SLOW_MO=0
